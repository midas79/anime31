generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Collection {
  id           Int      @id @default(autoincrement())
  anime_mal_id String   @unique
  anime_image  String?
  anime_title  String?
  createdAt    DateTime @default(now())
}
